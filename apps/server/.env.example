# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_NAME=run_territory

# Server
PORT=3000

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (Railway 등 환경변수 방식 — 우선 적용)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Firebase Admin SDK (로컬 JSON 파일 방식 — 위 3개 변수가 없을 때만 사용)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-key.json
